== S3 fm-pr-state on ghe.example.com ==
$ bin/fm-pr-state.sh https://ghe.example.com/my-org/my.repo/pull/42
CHECKS: none reported yet
exit=0 ; gh calls:
    GH_HOST=ghe.example.com | gh pr view https://ghe.example.com/my-org/my.repo/pull/42 --json state,mergedAt,isDraft,headRefOid,author,mergeable,reviewDecision --jq 
      "state=\(.state | ascii_downcase)",
      "merged_at=\(.mergedAt // "")",
      "draft=\(.isDraft)",
      "head=\(.headRefOid)",
      "author=\(.author.login)",
      "mergeability=\(if .mergeable == null or .mergeable == "UNKNOWN" then "unknown" else (.mergeable | ascii_downcase) end)",
      "review_decision=\(.reviewDecision // "")"
    GH_HOST=ghe.example.com | gh pr checks https://ghe.example.com/my-org/my.repo/pull/42 --required --json name,state,bucket --jq 
      .[]
      | select(.bucket != "pass" and .bucket != "skipping")
      | "REQUIRED CHECK: \(.name) (\(.state))"
